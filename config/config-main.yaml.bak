# =============================================================
# Amiga Driver Configuration
# =============================================================


# --- General Settings ---
General:
    # Root output data directory for all output
    Output Directory: ./recordings

    # Per-driver enable switches
    # It will be overrided by GUI
    Enable ASTERX: false
    Enable FX10: true
    Enable GOX: true
    Enable LMS4XXX: false

    # Path to the configuration files for each driver
    ASTERX Driver Config Path: ./asterx_driver/config/config-asterx.yaml
    FX10 Driver Config Path: ./fx10_driver/config/config-fx10.yaml
    GOX Driver Config Path: ./gox_driver/config/config-gox.yaml
    LMS4XXX Driver Config Path: ./lms4xxx_driver/config/config-lms4xxx.yaml

    # INS401 will not be supported in future update
    Enable INS401: false
    INS401 Driver Config Path: ./ins401_driver/config/config-ins401.yaml


# =============================================================
# NOT RECOMMEND TO CHANGE
# =============================================================
# --- Logging System ---
# Logging is managed centrally
Logging System:
    # Enable/disable system-wide logging for debugging and diagnostics
    # Disable will stop GUI
    Enable Logging: true
