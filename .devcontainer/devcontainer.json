{
    "name": "Phenomate Drivers Dev",
    "dockerComposeFile": "./docker-compose.yml",
    "service": "phenomate-drivers-dev",
    "runServices": ["phenomate-drivers-dev"],
    "overrideCommand": false,
    "workspaceFolder": "/workspace",

    // Container user settings
    "remoteUser": "dev",
    "updateRemoteUserUID": false,

    // Keep container running for CLion remote toolchain connection
    "shutdownAction": "none"
}
