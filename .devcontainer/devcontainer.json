{
    "name": "Amiga Drivers Dev",
    "dockerComposeFile": "./docker-compose.yml",
    "service": "amiga-drivers-dev",
    "runServices": ["amiga-drivers-dev", "gui"],
    "overrideCommand": false,
    "workspaceFolder": "/workspace",

    // Container user settings
    "remoteUser": "dev",
    "updateRemoteUserUID": false,

    // Keep container running for CLion remote toolchain connection
    "shutdownAction": "none"
}
